{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "跨物种细胞资料联邦领域事件",
  "description": "仅追加事件信封。事件一经接收，event_id/occurred_at/version 不得原地改写；业务更正只能产生后继事件。payload 携带事件专属内容，其业务规则由治理层执行。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "DATASET_REGISTERED",
        "DATASET_QUALITY_RECORDED",
        "MAPPING_REVISION_PROPOSED",
        "MAPPING_APPROVED",
        "LAYER_DERIVED",
        "RUN_BATCH_REGISTERED",
        "RUN_STARTED",
        "RUN_COMPLETED",
        "RUN_FAILED",
        "RUN_DEDUP_RECORDED",
        "CLAIM_PROPOSED",
        "CLAIM_REVIEWED",
        "CONSENT_GRANTED",
        "ACCESS_WITHDRAWN",
        "DERIVATIVE_FLAGGED",
        "PUBLICATION_RELEASED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "dataset_version",
        "ontology_mapping",
        "derived_layer",
        "run_batch",
        "model_run",
        "scientific_claim",
        "consent_grant",
        "publication"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string" }
      },
      "additionalProperties": true
    },
    "causation_id": {
      "type": "string",
      "minLength": 1,
      "description": "触发本事件的命令标识，构成命令→事件谱系。"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "description": "把同一业务活动（如一次发布、一轮复核）下的事件串起来。"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "命令幂等键：同键重试必须复用首次结果，不得产生第二个等价结果。"
    },
    "payload": {
      "type": "object",
      "description": "事件专属内容。数据集内容哈希、映射表修订、流水线步骤、模型参数、审查结论、同意范围等均在此登记。",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
